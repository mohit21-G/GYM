# ==========================================
# Google Fitness AI Chatbot - Environment Config
# ==========================================

# Application Environment
NODE_ENV=development
APP_NAME="Google Fitness AI Chatbot"
APP_VERSION=1.0.0

# Backend Configuration
BACKEND_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=google-Fitness-ai-chatbot
DATABASE_URL="mysql://root:123456@localhost:3306/google-Fitness-ai-chatbot"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=supersecretjwtkey_Fitness_ai_production_change_me_123456
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_Fitness_ai_change_me_789012
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI Provider Configuration
# Supported: cloudflare | openai | mistral | gemini
AI_PROVIDER=cloudflare
AI_MODEL=@cf/zai-org/glm-4.7-flash
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Provider Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
OPENAI_API_KEY=your_openai_api_key
MISTRAL_API_KEY=your_mistral_api_key
GEMINI_API_KEY=your_gemini_api_key

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Reverse Proxy / Docker Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
