// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  EVENING_SNACK
  DINNER
  SNACK
}

enum ActivityIntensity {
  LOW
  MEDIUM
  HIGH
}

enum SleepQuality {
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum LogSource {
  CHAT
  MANUAL
}

enum AIUsageStatus {
  SUCCESS
  FAILED
}

model User {
  id                String       @id @default(uuid())
  name              String
  username          String?      @unique
  email             String       @unique
  passwordHash      String       @map("password_hash")
  role              Role         @default(CUSTOMER)
  status            UserStatus   @default(ACTIVE)
  timezone          String       @default("Asia/Kolkata")
  preferredLanguage String       @default("en") @map("preferred_language")
  lastLoginAt       DateTime?    @map("last_login_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  profile           UserProfile?
  chatSessions      ChatSession[]
  foodLogs          FoodLog[]
  activityLogs      ActivityLog[]
  weightLogs        WeightLog[]
  sleepLogs         SleepLog[]
  hydrationLogs     HydrationLog[]
  aiUsageLogs       AIUsageLog[]
  adminAuditLogs    AdminAuditLog[] @relation("AdminAudits")

  @@index([role])
  @@index([status])
  @@index([email])
  @@map("users")
}

model UserProfile {
  id                      String        @id @default(uuid())
  userId                  String        @unique @map("user_id")
  age                     Int?
  gender                  Gender?       @default(MALE)
  heightCm                Float?        @map("height_cm")
  currentWeightKg         Float?        @map("current_weight_kg")
  targetWeightKg          Float?        @map("target_weight_kg")
  dailyCalorieTarget      Int?          @default(2000) @map("daily_calorie_target")
  dailyWaterMlTarget      Int?          @default(2500) @map("daily_water_ml_target")
  dailySleepMinutesTarget Int?          @default(480) @map("daily_sleep_minutes_target")
  activityLevel           ActivityLevel @default(MODERATE) @map("activity_level")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ChatSession {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  title      String?       @default("New Conversation")
  isArchived Boolean       @default(false) @map("is_archived")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id               String        @id @default(uuid())
  sessionId        String        @map("session_id")
  sender           MessageSender
  message          String        @db.Text
  rawEntities      String?       @map("raw_entities") @db.Text
  detectedIntent   String?       @map("detected_intent")
  language         String?
  aiProvider       String?       @map("ai_provider")
  aiModel          String?       @map("ai_model")
  promptTokens     Int?          @default(0) @map("prompt_tokens")
  completionTokens Int?          @default(0) @map("completion_tokens")
  totalTokens      Int?          @default(0) @map("total_tokens")
  latencyMs        Int?          @default(0) @map("latency_ms")
  createdAt        DateTime      @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model FoodCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  foods Food[]

  @@map("food_categories")
}

model Food {
  id                  String   @id @default(uuid())
  categoryId          String   @map("category_id")
  name                String
  standardServingSize Float    @default(100) @map("standard_serving_size")
  standardServingUnit String   @default("g") @map("standard_serving_unit")
  caloriesPerServing  Float    @map("calories_per_serving")
  proteinG            Float    @default(0) @map("protein_g")
  carbsG              Float    @default(0) @map("carbs_g")
  fatG                Float    @default(0) @map("fat_g")
  fiberG              Float    @default(0) @map("fiber_g")
  sodiumMg            Float    @default(0) @map("sodium_mg")
  synonyms            String?  @db.Text
  isCustom            Boolean  @default(false) @map("is_custom")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  category FoodCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  logs     FoodLog[]

  @@index([name])
  @@index([categoryId])
  @@map("foods")
}

model FoodLog {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  foodId     String?   @map("food_id")
  foodName   String    @map("food_name")
  mealType   MealType  @default(SNACK) @map("meal_type")
  quantity   Float     @default(1)
  unit       String    @default("serving")
  loggedAt   DateTime  @default(now()) @map("logged_at")
  calories   Float
  proteinG   Float     @default(0) @map("protein_g")
  carbsG     Float     @default(0) @map("carbs_g")
  fatG       Float     @default(0) @map("fat_g")
  fiberG     Float     @default(0) @map("fiber_g")
  notes      String?
  source     LogSource @default(CHAT)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([loggedAt])
  @@map("food_logs")
}

model ActivityCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activities Activity[]

  @@map("activity_categories")
}

model Activity {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  metValue    Float    @default(3.0) @map("met_value")
  description String?
  synonyms    String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  logs     ActivityLog[]

  @@index([name])
  @@index([categoryId])
  @@map("activities")
}

model ActivityLog {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  activityId            String?           @map("activity_id")
  activityName          String            @map("activity_name")
  durationMinutes       Float             @map("duration_minutes")
  metValue              Float             @default(3.0) @map("met_value")
  intensity             ActivityIntensity @default(MEDIUM)
  userWeightKgSnapshot Float             @default(70.0) @map("user_weight_kg_snapshot")
  caloriesBurned        Float             @map("calories_burned")
  distanceKm            Float?            @map("distance_km")
  loggedAt              DateTime          @default(now()) @map("logged_at")
  source                LogSource         @default(CHAT)
  notes                 String?
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([loggedAt])
  @@map("activity_logs")
}

model WeightLog {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  weightKg  Float     @map("weight_kg")
  bmi       Float?
  loggedAt  DateTime  @default(now()) @map("logged_at")
  source    LogSource @default(CHAT)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
  @@map("weight_logs")
}

model SleepLog {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  durationMinutes   Int           @map("duration_minutes")
  quality           SleepQuality? @default(GOOD)
  deepSleepMinutes  Int?          @default(0) @map("deep_sleep_minutes")
  remSleepMinutes   Int?          @default(0) @map("rem_sleep_minutes")
  loggedAt          DateTime      @default(now()) @map("logged_at")
  source            LogSource     @default(CHAT)
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
  @@map("sleep_logs")
}

model HydrationLog {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  amountMl  Int       @map("amount_ml")
  loggedAt  DateTime  @default(now()) @map("logged_at")
  source    LogSource @default(CHAT)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
  @@map("hydration_logs")
}

model AIUsageLog {
  id               String        @id @default(uuid())
  userId           String?       @map("user_id")
  provider         String
  model            String
  intentDetected   String?       @map("intent_detected")
  promptTokens     Int           @default(0) @map("prompt_tokens")
  completionTokens Int           @default(0) @map("completion_tokens")
  totalTokens      Int           @default(0) @map("total_tokens")
  latencyMs        Int           @default(0) @map("latency_ms")
  status           AIUsageStatus @default(SUCCESS)
  errorMessage     String?       @map("error_message") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model AdminAuditLog {
  id             String   @id @default(uuid())
  adminId        String   @map("admin_id")
  action         String
  targetResource String   @map("target_resource")
  targetId       String?  @map("target_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  changes        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  admin User @relation("AdminAudits", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetResource])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
